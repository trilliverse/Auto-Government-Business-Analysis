{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/pipeline/stage-3-swimlane.schema.json",
  "title": "Stage 3 Swimlane Logic Models",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "stage_2_draft_sha256", "models"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "case_id": {"type": "string"},
    "stage_2_draft_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "item_text", "page_name", "lanes", "nodes", "edges", "system_notes", "unresolved_questions", "status"],
        "properties": {
          "item_id": {"type": "string"},
          "item_text": {"type": "string"},
          "page_name": {"type": "string"},
          "lanes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["lane_id", "name"], "properties": {"lane_id": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": false}},
          "nodes": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["node_id", "lane_id", "type", "label", "evidence_status"], "properties": {"node_id": {"type": "string"}, "lane_id": {"type": "string"}, "type": {"enum": ["start", "activity", "decision", "result", "end", "placeholder"]}, "label": {"type": "string"}, "evidence_status": {"enum": ["direct", "inferred", "human", "unresolved"]}}, "additionalProperties": false}},
          "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["edge_id", "source", "target", "label"], "properties": {"edge_id": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"}, "label": {"type": "string"}}, "additionalProperties": false}},
          "system_notes": {"type": "array", "items": {"type": "string"}},
          "unresolved_questions": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["draft", "reviewed", "approved", "rejected"]}
        }
      }
    }
  }
}
