{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/pipeline/case.schema.json",
  "title": "Governance Pipeline Case Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "title", "organization", "stage", "status", "input_version", "inputs", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_name", "department_name"],
      "properties": {
        "unit_name": {"type": "string", "minLength": 1},
        "department_name": {"type": "string", "minLength": 1}
      }
    },
    "stage": {"enum": ["gate-0", "stage-1", "gate-1", "stage-2", "gate-2", "stage-3", "gate-3", "gate-4", "completed"]},
    "status": {"enum": ["awaiting-input-review", "drafting", "awaiting-review", "approved", "changes-requested", "stale", "completed"]},
    "input_version": {"type": "integer", "minimum": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibilities"],
      "properties": {
        "responsibilities": {"type": "string", "const": "inputs/responsibilities.json"}
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "gate_0_approval": {"type": "string", "const": "reviews/gate-0-decision.json"},
    "stage_1_approval": {"type": "string", "const": "reviews/gate-1-decision.json"},
    "stage_1_approved_artifact": {"type": "string", "minLength": 1},
    "stage_1_approved_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "stage_2_approval": {"type": "string", "const": "reviews/gate-2-decision.json"},
    "stage_2_approved_artifact": {"type": "string", "minLength": 1},
    "stage_2_approved_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "stage_3_approval": {"type": "string", "const": "reviews/gate-3-decision.json"},
    "stage_3_approved_artifact": {"type": "string", "minLength": 1},
    "stage_3_approved_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
  }
}
