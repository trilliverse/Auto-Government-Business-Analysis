{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/pipeline/stage-1-items.schema.json",
  "title": "Stage 1 Responsibility Items Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "input_version", "input_sha256", "skill", "status", "items"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "input_version": {"type": "integer", "minimum": 1},
    "input_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "responsibility-decomposition"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["draft", "awaiting-review", "approved"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "source_responsibility_id", "source_sequence", "item_sequence", "item_text", "action", "object", "category", "derivation_note", "issues", "disposition", "status"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "source_responsibility_id": {"type": "string", "minLength": 1},
          "source_sequence": {"type": "integer", "minimum": 1},
          "item_sequence": {"type": "integer", "minimum": 1},
          "item_text": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "object": {"type": "string", "minLength": 1},
          "category": {"enum": ["督导", "组织", "负责", "参与", "待确认"]},
          "derivation_note": {"type": "string"},
          "issues": {"type": "array", "items": {"type": "string"}},
          "disposition": {"enum": ["include", "exclude-proposed"]},
          "status": {"enum": ["draft", "reviewed", "approved", "rejected"]}
        }
      }
    }
  }
}
